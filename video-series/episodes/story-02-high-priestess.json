  "segments": [
    { "id": "opening", "scene": "hook", "at": 0.8, "textEnd": 5.117, "before": 6, "say": "今天的女祭司，曾在旧牌里戴着女教皇的冠。" },
    { "id": "deck", "scene": "story", "at": 6.8, "textEnd": 11.143, "before": 13, "say": "她手里的那本书，比今天这副牌早了四百多年。" },
    { "id": "history", "scene": "story", "at": 14.05, "textEnd": 19.252, "before": 20.22, "say": "米兰的手绘牌画了三重冠。法国的木刻里，她仍捧着书。" },
    { "id": "scroll", "scene": "glance", "at": 20.32, "textEnd": 22.540, "before": 22.68, "say": "史密斯把书画成了卷轴。" },
    { "id": "veil", "scene": "glance", "at": 22.78, "textEnd": 24.461, "before": 24.9, "say": "柱间是石榴帷幕。" },
    { "id": "moon", "scene": "glance", "at": 25.0, "textEnd": 26.517, "before": 27.2, "say": "脚边是一弯月。" },
    { "id": "ritual", "scene": "quote", "at": 30.22, "textEnd": 33.657, "before": 35, "say": "留十分钟，写下你此刻最想弄明白的事。" },
    { "id": "signature", "scene": "promo", "at": 39.82, "textEnd": 43.624, "before": 44.6, "say": "晨启塔罗。七十八张牌，白话解读。" }
  ]
